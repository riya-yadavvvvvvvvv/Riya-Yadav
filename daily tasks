#include <stdio.h>

int main()
{
    int choice, i;
    int completed[50] = {0};
    char tasks[50][100];
    int count = 0;

    printf("*================================*\n");
    printf("   DAILY ROUTINE MANAGER\n");
    printf("*================================*\n");

    do
    {
        printf("\n1. Add a Task");
        printf("\n2. View All Tasks");
        printf("\n3. Mark Task as Completed");
        printf("\n4. Exit");

        printf("\n\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                if(count < 50)
                {
                    printf("Enter your task: ");
                    scanf(" %99[^\n]", tasks[count]);

                    completed[count] = 0;
                    count++;

                    printf("Task added successfully!\n");
                }
                else
                {
                    printf("Task limit reached!\n");
                }
                break;

            case 2:
                if(count == 0)
                {
                    printf("No tasks added yet!\n");
                }
                else
                {
                    printf("\nYour Daily Tasks:\n");

                    for(i = 0; i < count; i++)
                    {
                        printf("%d. %s", i + 1, tasks[i]);

                        if(completed[i] == 1)
                            printf(" - Completed\n");
                        else
                            printf(" - Pending\n");
                    }
                }
                break;

            case 3:
                printf("Enter task number: ");
                scanf("%d", &i);

                if(i >= 1 && i <= count)
                {
                    completed[i - 1] = 1;
                    printf("Task marked as completed!\n");
                }
                else
                {
                    printf("Invalid task number!\n");
                }
                break;

            case 4:
                printf("Thank you for using Daily Routine Manager!\n");
                break;

            default:
                printf("Invalid choice! Try again.\n");
        }

    } while(choice != 4);

    return 0;
}
